<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:background="@color/black">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Nhập số thứ nhất"
            android:textSize="30dp"
            android:textColor="#2196F3"/>
        <EditText
            android:id="@+id/Edtso1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhập số ở đây"
            android:textSize="15dp"
            android:textColor="@color/cardview_light_background"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:background="@color/black">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Nhập số thứ hai"
            android:textSize="30dp"
            android:textColor="#2196F3"
            />

        <EditText
            android:id="@+id/Edtso2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhập số ở đây"
            android:layout_marginLeft="20dp"
            android:textSize="15dp"
            android:textColor="@color/cardview_light_background"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:padding="5dp"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:gravity="center_horizontal">
        <Button
            android:id="@+id/BtnCong"
            android:layout_margin="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"/>
        <Button
            android:id="@+id/BtnTru"

            android:layout_margin="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"/>
        <Button
            android:id="@+id/BtnNhan"

            android:layout_margin="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="*"/>
        <Button
            android:id="@+id/BtnChia"

            android:layout_margin="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:background="@color/black">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Kết quả là: "
            android:textSize="30dp"
            android:textColor="#2196F3"
            />
        <EditText
            android:id="@+id/EdtKetQua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="kết quả ở đây"
            android:layout_marginLeft="20dp"
            android:textSize="15dp"
            android:textColor="@color/cardview_light_background"/>
        
</LinearLayout>